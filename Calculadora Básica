using System;

class Program {
    static void Main() {
        // Entrada dos números
        Console.Write("Digite o primeiro número: ");
        double num1 = double.Parse(Console.ReadLine());

        Console.Write("Digite o segundo número: ");
        double num2 = double.Parse(Console.ReadLine());

        // Entrada do operador
        Console.Write("Digite o operador (+, -, *, /): ");
        char operador = Console.ReadKey().KeyChar;
        Console.WriteLine(); // Quebra de linha apenas para organização

        double resultado;

        // Estrutura de decisão para a operação
        switch (operador) {
            case '+':
                resultado = num1 + num2;
                Console.WriteLine($"Resultado: {num1} + {num2} = {resultado}");
                break;
            case '-':
                resultado = num1 - num2;
                Console.WriteLine($"Resultado: {num1} - {num2} = {resultado}");
                break;
            case '*':
                resultado = num1 * num2;
                Console.WriteLine($"Resultado: {num1} * {num2} = {resultado}");
                break;
            case '/':
                // Verificação de segurança: Divisão por zero
                if (num2 != 0) {
                    resultado = num1 / num2;
                    Console.WriteLine($"Resultado: {num1} / {num2} = {resultado}");
                } else {
                    Console.WriteLine("Erro: Não é possível dividir por zero.");
                }
                break;
            default:
                Console.WriteLine("Operador inválido! Use +, -, * ou /.");
                break;
        }
    }
}
