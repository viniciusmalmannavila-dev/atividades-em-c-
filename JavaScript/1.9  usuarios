const usuarios = [
    { nome: 'Ana', ativo: true },
    { nome: 'Rodrigo', ativo: false },
    { nome: 'Beatriz', ativo: true },
    { nome: 'Lucas', ativo: false }
];

// Filtra apenas os usuários ativos
const usuariosAtivos = usuarios.filter(usuario => usuario.ativo === true);

// Percorre o novo array e exibe a mensagem
usuariosAtivos.forEach(usuario => {
    console.log(`Usuário ${usuario.nome} está online!`);
});
