// 1. Criando o array estoque
let estoque = [
  { id: 1, nome: "Mouse", preco: 90, qtd: 5 },
  { id: 2, nome: "Teclado", preco: 150, qtd: 3 },
  { id: 3, nome: "Monitor", preco: 800, qtd: 2 }
];

// 3. Exibindo informações no console
console.log("Primeiro produto:", estoque[0].nome);
console.log("Preço do último produto:", estoque[estoque.length - 1].preco);

// 4. Adicionando um 4º produto no final do array
estoque.push({
  id: 4,
  nome: "Headset",
  preco: 250,
  qtd: 4
});

console.log("Estoque após adicionar produto:", estoque);

// 5. Removendo o primeiro produto do array
estoque.shift();

console.log("Estoque após remover o primeiro produto:", estoque);
